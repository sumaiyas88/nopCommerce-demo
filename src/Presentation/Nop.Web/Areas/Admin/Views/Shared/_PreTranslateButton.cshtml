@model string

<button id="pre-translate" type="button" name="@Model" class="btn bg-olive">
    <i class="fas fa-globe"></i>
    @T("Admin.Common.PreTranslate")
</button>


<script>
    $(function() {
        $('#pre-translate').click(function () {
            var productId = $('#Id').val();

            var postData = {
                productId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action(Model))",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    for (const [key, value] of Object.entries(data.Locales)) {

                          var t = $('#' + key);                          
                          if (t[0].classList.contains('summernote')) {
                            t.summernote("code", value);
                          }
                          else {
                            $('#'+key).val(value);
                          }
                        }

                    displayBarNotification('@T("Admin.Translation.Translated")', 0);
                }
            });
        });
    });
</script>